# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# SQLite par défaut : aucun serveur à installer, le fichier est créé au db:push.
DATABASE_URL="file:./dev.db"
# Pour passer à PostgreSQL : changer `provider = "postgresql"` dans
# prisma/schema.prisma, puis :
# DATABASE_URL="postgresql://user:password@localhost:5432/cookbook?schema=public"

# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Origines autorisées pour CORS, séparées par des virgules.
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# IA — au moins un provider doit être configuré pour l'import automatique.
# L'ajout manuel de recettes fonctionne sans aucune clé.
# ---------------------------------------------------------------------------
# Provider utilisé en priorité : "anthropic" | "openai" | "gemini"
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# YouTube (optionnel) — enrichit les métadonnées via l'API officielle.
# Sans clé, l'import YouTube se rabat sur oEmbed + page publique.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Authentification Google
# ---------------------------------------------------------------------------
# Sans ces deux clés, le serveur démarre mais la connexion est indisponible
# (et donc tout ce qui touche au fichier personnel).
#
# Où les obtenir : console.cloud.google.com → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application.
# Dans « Authorized redirect URIs », colle EXACTEMENT :
#   http://localhost:4000/api/auth/google/callback
# (en production : https://<ton-domaine>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresse publique du serveur — sert à construire l'URI de redirection
# ci-dessus. En production, mets l'adresse réelle du site.
PUBLIC_SERVER_URL="http://localhost:4000"
# Où le navigateur est renvoyé après connexion (le front).
PUBLIC_APP_URL="http://localhost:5173"

# Secret de signature du cookie de session. OBLIGATOIRE en production ; en
# développement, un secret éphémère est tiré au démarrage (les sessions ne
# survivent alors pas à un redémarrage du serveur).
# Génère-le une fois puis conserve-le :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Durée de vie d'une session, en jours.
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Sécurité réseau de l'import (anti-SSRF)
# ---------------------------------------------------------------------------
# Taille maximale téléchargée par URL, en octets (2 Mo).
FETCH_MAX_BYTES=2097152
# Timeout réseau par requête, en ms.
FETCH_TIMEOUT_MS=15000
# Nombre maximal de redirections suivies (chacune est revalidée).
FETCH_MAX_REDIRECTS=3
# Mettre à 1 UNIQUEMENT pour tester contre un serveur local.
ALLOW_PRIVATE_ADDRESSES=0
